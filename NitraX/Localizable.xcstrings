            "value": "Keep all"
          }
        }
      }
    },
    "Alle offline gespeicherten Werke vom iPhone löschen? Am PC bleibt alles erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all works saved offline from this iPhone? Everything stays on the PC."
          }
        }
      }
    },
    "Alles ausgefüllt! Tippe jetzt unten auf »Starten« – danach kannst du live mitverfolgen, was der PC macht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All filled in! Now tap »Start« below – then you can follow live what the PC is doing."
          }
        }
      }
    },
    "Als Nächstes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next up"
          }
        }
      }
    },
    "Am PC noch einrichten: NitraX → Einstellungen → Handy → iPhone-Push": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still to set up on the PC: NitraX → Settings → Phone → iPhone push"
          }
        }
      }
    },
    "Am PC: NitraX AI Studio → Einstellungen → Handy → »Handy-Zugang« an": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the PC: NitraX AI Studio → Settings → Phone → turn on »Phone access«"
