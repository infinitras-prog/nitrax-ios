{
  "sourceLanguage": "de",
  "strings": {
    "1. NitraX am PC gestartet?  2. PC wach (nicht im Standby)?  3. Gleiches WLAN – unterwegs Tailscale an?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Is NitraX running on the PC?  2. Is the PC awake (not in standby)?  3. Same Wi-Fi – on the go, is Tailscale on?"
          }
        }
      }
    },
    "10 Minuten vorher erinnern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me 10 minutes before"
          }
        }
      }
    },
